{
  "name": "siphon-subgraph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "codegen:sepolia": "graph codegen subgraph.sepolia.yaml",
    "build:sepolia": "graph build subgraph.sepolia.yaml",
    "deploy:studio": "graph deploy --studio siphon-vaults",
    "deploy:studio:sepolia": "graph deploy --studio siphon-vaults-sepolia subgraph.sepolia.yaml",
    "create:local": "graph create --node http://localhost:8020/ siphon/vaults",
    "deploy:local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 siphon/vaults"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.97.1",
    "@graphprotocol/graph-ts": "^0.37.0"
  }
}
