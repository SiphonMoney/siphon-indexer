# Postgres (dedicated indexer DB on the shared server)
# Ponder dev reads `.env.local` — copy this file: cp .env.example .env.local
DATABASE_URL=postgresql://siphon:siphon_secure_pass@localhost:5432/siphon_indexer

# RPC endpoints (used for backfill + live sync)
PONDER_RPC_URL_8453=https://mainnet.base.org
PONDER_RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com

# Deploy blocks (earliest block to scan)
BASE_DEPLOY_BLOCK=48026000
SEPOLIA_DEPLOY_BLOCK=11168257

# Vault + MerkleTree addresses (required) — run: npm run resolve-addresses >> .env.local
MERKLE_TREE_BASE_ETH=0x9b71269665f38A63C76a99A2966AbC9a25c41741
MERKLE_TREE_BASE_USDC=0xff5365729C2Aa9Ef6d04C0D58c5c6FD1B5aCc4e8
MERKLE_TREE_SEPOLIA_ETH=0xedcB2124Ad0e8c88E078C19C821d4168A7cd6270
MERKLE_TREE_SEPOLIA_USDC=0x13C89BBb7648Fa9E645ce1281c0E032Bb5eeb8F0
VAULT_BASE_ETH=0x6a6391854c078Ad1C365d66ca078461acc02B201
VAULT_BASE_USDC=0xb5187De5f97753c75B0c70e69cDAA0b246ea6FD9
VAULT_SEPOLIA_ETH=0x04e4ED1f04eF791ce0f0a11d1f23376eAbc04a93
VAULT_SEPOLIA_USDC=0xD7c12dA0465e9099B183fb0fa79493D2782Ca180

# For resolve-addresses script
ENTRYPOINT_BASE=0xe4645c9f3c479524B3B6F411B3Bcb9E0d2c28788
ENTRYPOINT_SEPOLIA=0x342326835884b65C27c00249506dA440590FFb6f
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Base Veil Cash mixer association (tornado_touch) — default on
INDEX_BASE_MIXERS=1
# BASE_MIXER_START_BLOCK=20000000

# Official Base↔ETH StandardBridge edges (bridge_edge)
INDEX_BASE_BRIDGES=1
# BASE_BRIDGE_START_BLOCK=1

# Ethereum classic Tornado → tornado_touch (requires PONDER_RPC_URL_1)
INDEX_ETH_TORNADO=1
PONDER_RPC_URL_1=https://ethereum.publicnode.com
# ETH_MIXER_START_BLOCK=15000000
# PONDER_MAX_RPS_ETH=10

# Across + Hop + Stargate → bridge_edge (requires PONDER_RPC_URL_1)
INDEX_THIRD_PARTY_BRIDGES=1
INDEX_HOP_BRIDGES=1
# THIRD_PARTY_BRIDGE_START_BLOCK=15000000
# Stargate V2 pools (empty = doc defaults: native+USDC on Base and ETH). Set =0 to disable.
# STARGATE_BASE_POOLS=
# STARGATE_ETH_POOLS=
# Production must run one scope per process. `all` is retained for local development only.
INDEXER_SCOPE=all
